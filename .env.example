OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_PARSE_MODEL=gpt-4o-mini
REDIS_URL=https://your-redis-rest-endpoint
REDIS_TOKEN=
# Temporary local/integration-test credential. Send it in X-Firebase-AppCheck
# to bypass verification for that request; Firebase credentials remain required.
APP_AUTH_TEST_TOKEN=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ALLOWED_APP_IDS=1:1234567890:android:replace-with-your-app-id
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_TEXT_LENGTH=2000
MAX_JSON_BODY_BYTES=10000
MAX_AUDIO_SIZE_BYTES=4000000
MAX_AUDIO_DURATION_SECONDS=600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_IP=10
RATE_LIMIT_PARSE_IP=20
RATE_LIMIT_PARSE_TOKEN=20
RATE_LIMIT_TRANSCRIBE_IP=10
RATE_LIMIT_TRANSCRIBE_TOKEN=10
UPSTREAM_TIMEOUT_MS=20000

